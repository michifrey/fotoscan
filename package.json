{
  "name": "fotoscan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA zum Digitalisieren alter Fotoalben mit dem Smartphone",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/make-test-fixture.mjs && playwright test",
    "fixture": "node scripts/make-test-fixture.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
